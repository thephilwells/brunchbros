{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate Structural Pilot",
      "type": "shell",
      "command": "node",
      "args": ["tools/generate-structural-pilot.mjs"],
      "problemMatcher": []
    },
    {
      "label": "Generate Dining Room",
      "type": "shell",
      "command": "node",
      "args": ["tools/generate-dining-room.mjs"],
      "problemMatcher": []
    },
    {
      "label": "Convert Dining Room",
      "type": "shell",
      "command": "rgbgfx",
      "args": ["-c", "dmg=E4", "-o", "build/dining_room.2bpp", "gfx/dining_room.png"],
      "problemMatcher": []
    },
    {
      "label": "Verify Dining Room",
      "type": "shell",
      "command": "node",
      "args": ["tools/verify-dining-room.mjs"],
      "problemMatcher": []
    },
    {
      "label": "Convert Chef Frames",
      "type": "shell",
      "command": "for f in chef_idle0 chef_idle1 chef_walk0 chef_walk1 chef_walk2 chef_walk3 chef_walk4 chef_walk5 chef_jump chef_ascent chef_crouch chef_ledge; do rgbgfx -c dmg=E4 -o build/$f.2bpp gfx/$f.png; done",
      "problemMatcher": []
    },
    {
      "label": "Assemble",
      "type": "shell",
      "command": "rgbasm",
      "args": [
        "-o",
        "build/main.o",
        "src/main.asm"
      ],
      "problemMatcher": []
    },
    {
      "label": "Link",
      "type": "shell",
      "command": "rgblink",
      "args": [
        "-o",
        "build/brunchbros.gb",
        "-m",
        "build/main.map",
        "-n",
        "build/main.sym",
        "build/main.o"
      ],
      "problemMatcher": []
    },
    {
      "label": "Fix",
      "type": "shell",
      "command": "rgbfix",
      "args": [
        "-v",
        "-p",
        "0xFF",
        "build/brunchbros.gb"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build ROM",
      "dependsOrder": "sequence",
      "dependsOn": ["Generate Structural Pilot", "Generate Dining Room", "Convert Dining Room", "Verify Dining Room", "Convert Chef Frames", "Assemble", "Link", "Fix"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run in SameBoy",
      "type": "shell",
      "command": "open",
      "args": [
        "-a",
        "/Applications/SameBoy.app",
        "${workspaceFolder}/build/brunchbros.gb"
      ],
      "dependsOn": "Build ROM",
      "problemMatcher": []
    }
  ]
}
