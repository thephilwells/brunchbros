      "args": ["tools/generate-level-gallery.mjs"],
      "problemMatcher": []
    },
    {
      "label": "Convert Chef Frames",
      "type": "shell",
      "command": "for f in chef_idle0 chef_idle1 chef_walk0 chef_walk1 chef_walk2 chef_walk3 chef_walk4 chef_walk5 chef_jump chef_ascent chef_crouch chef_ledge chef_attack_windup chef_attack_strike chef_attack_recovery chef_death pan_attack_windup pan_attack_strike pan_attack_recovery; do rgbgfx -c dmg=E4 -o build/$f.2bpp gfx/$f.png; done",
      "problemMatcher": []
    },
    {
      "label": "Assemble",
      "type": "shell",
      "command": "rgbasm",
      "args": [
        "-o",
        "build/main.o",
        "src/main.asm"
      ],
      "problemMatcher": []
    },
    {
      "label": "Link",
      "type": "shell",
      "command": "rgblink",
      "args": [
        "-o",
        "build/brunchbros.gb",
        "-m",
        "build/main.map",
        "-n",
        "build/main.sym",
        "build/main.o"
      ],
      "problemMatcher": []
    },
    {
      "label": "Fix",
      "type": "shell",
      "command": "rgbfix",
      "args": [
        "-v",
        "-p",
        "0xFF",
        "build/brunchbros.gb"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build ROM",
      "dependsOrder": "sequence",
      "dependsOn": ["Generate Structural Pilot", "Generate Dining Room", "Generate Chef Attack", "Generate HUD", "Generate WEINER", "Generate Room Template Fixture", "Generate Room Template Playtest", "Generate Seeded Level", "Generate Room Variant Playtest", "Convert Dining Room", "Convert HUD", "Convert WEINER", "Verify Dining Room", "Verify Dining Room Furniture", "Verify Dining Room Background", "Verify Dining Room Wallpaper", "Verify Dining Room Composition", "Verify Room Templates", "Verify Room Template Playtest", "Verify Seeded Level", "Verify Room Variant Playtest", "Convert Chef Frames", "Assemble", "Link", "Fix"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run in SameBoy",
      "type": "shell",
      "command": "open",
      "args": [
        "-a",
        "/Applications/SameBoy.app",
        "${workspaceFolder}/build/brunchbros.gb"
      ],
      "dependsOn": "Build ROM",
      "problemMatcher": []
